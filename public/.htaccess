<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirects 301 — consolidação SEO
  RewriteRule ^blog/qi-medio-brasil/?$ /blog/media-qi-brasil [R=301,L]
  RewriteRule ^blog/nature-vs-nurture-genetica-ambiente-qi/?$ /blog/genetica-vs-ambiente-qi [R=301,L]
  RewriteRule ^blog/qi-e-genetica-quanto-nasce-aprende/?$ /blog/genetica-vs-ambiente-qi [R=301,L]
  RewriteRule ^blog/qi-e-genetica-quanto-nasce-quanto-aprende/?$ /blog/genetica-vs-ambiente-qi [R=301,L]
  RewriteRule ^blog/teste-qi-gratis/?$ /blog/teste-de-qi-gratuito [R=301,L]
  RewriteRule ^blog/teste-qi-gratuito-sem-cadastro/?$ /blog/teste-de-qi-sem-cadastro [R=301,L]
  RewriteRule ^blog/como-descobrir-meu-qi/?$ /blog/como-saber-meu-qi [R=301,L]
  RewriteRule ^blog/melhores-testes-qi-online-2025/?$ /blog/melhores-testes-qi-online-2026 [R=301,L]
  RewriteRule ^blog/inteligencias-multiplas-monetizar/?$ /blog/inteligencia-multiplas-monetizar [R=301,L]
  RewriteRule ^blog/teste-de-qi-infantil/?$ /blog/teste-qi-infantil [R=301,L]
  RewriteRule ^blog/calculadora-de-qi/?$ /blog/calcular-qi [R=301,L]
  RewriteRule ^blog/calculadora-qi/?$ /blog/calcular-qi [R=301,L]

  # HTML prerenderizado do blog
  RewriteRule ^blog/([^/]+)/?$ blog/$1/index.html [L]
  RewriteRule ^blog/?$ blog/index.html [L]

  # HTML prerenderizado de páginas institucionais
  RewriteRule ^(sobre-o-teste|como-funciona|perguntas-frequentes|qi-por-pais|contato|politica-privacidade|termos-uso)/?$ $1/index.html [L]

  # SPA fallback: só se o arquivo/diretório NÃO existir
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.(css|js|mjs|map|png|jpg|jpeg|gif|svg|webp|ico|woff2?|ttf|txt|xml|json)$ [NC]
  RewriteRule . /index.html [L]
</IfModule>
